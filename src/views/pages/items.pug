extends ../layouts/layout.pug

block content
  section.page-header
    h1.page-title Catálogo de Productos
    p.page-subtitle Encuentra los mejores componentes y periféricos para tu estación de trabajo o juego.

  section.catalog-controls
    form.filter-form(action="/items", method="GET")
      .form-group
        label(for="q") Buscar por nombre o descripción:
        input#q.form-input(type="text", name="q", value=searchQuery, placeholder="Ej. teclado, monitor...")

      .form-group
        label(for="category") Filtrar por categoría:
        select#category.form-select(name="category")
          option(value="") Todas las categorías
          each cat in categories
            option(value=cat, selected=(currentCategory === cat))= cat

      .form-actions
        button.btn.btn-primary(type="submit") Filtrar
        if searchQuery || currentCategory
          a.btn.btn-outline(href="/items") Limpiar Filtros

  section.catalog-results
    if items && items.length > 0
      p.results-count Mostrando <strong>#{items.length}</strong> producto(s) disponible(s).
      .items-grid
        each item in items
          article.product-card
            .product-image-container
              img.product-image(src=item.image, alt=`Imagen del producto ${item.name}`, loading="lazy")
            .product-info
              .product-meta
                span.product-category= item.category
                span.product-stock(class=(item.stock > 0 ? "in-stock" : "out-of-stock"))
                  = item.stock > 0 ? `Stock: ${item.stock}` : "Sin Stock"
              h2.product-title= item.name
              p.product-description= item.description
              .product-footer
                span.product-price $#{item.price.toLocaleString('es-AR')}
                a.btn.btn-card(href=`/items/${item.id}`) Ver Detalle
    else
      .empty-state
        p.empty-message No se encontraron productos que coincidan con los criterios de búsqueda.
        a.btn.btn-primary(href="/items") Ver todos los productos

