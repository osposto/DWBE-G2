extends ../layouts/layout.pug

block content
  nav.breadcrumb-nav(aria-label="Navegación secundaria")
    ol.breadcrumb-list
      li
        a(href="/") Inicio
      li.separator /
      li
        a(href="/items") Catálogo
      li.separator /
      li.active(aria-current="page")= item.name

  section.product-detail-section
    article.detail-container
      .detail-gallery
        img.detail-image(src=item.image, alt=`Fotografía detallada de ${item.name}`, loading="eager")
      .detail-info
        .detail-meta
          span.product-category= item.category
          span.detail-id Identificador único: ##{item.id}
        h1.detail-title= item.name
        p.detail-price $#{item.price.toLocaleString('es-AR')}

        .detail-description-box
          h2 Descripción del Producto
          p= item.description

        .detail-specifications
          h2 Disponibilidad y Especificaciones
          ul.spec-list
            li
              strong Estado de Inventario: 
              span.stock-indicator(class=(item.stock > 0 ? "in-stock" : "out-of-stock"))
                = item.stock > 0 ? `${item.stock} unidades en stock` : "Agotado temporalmente"
            li
              strong Categoría: 
              span= item.category
            li
              strong Garantía: 
              span 12 meses de garantía oficial

        .detail-actions
          a.btn.btn-outline(href="/items") &larr; Volver al Catálogo

