doctype html
html(lang="es")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    meta(http-equiv="X-UA-Compatible", content="ie=edge")
    meta(name="description", content=description || "Sistema de gestión integral y alta comercial de cuentas agropecuarias - Proceso P1.")
    meta(name="robots", content="index, follow")
    title= title || "AgroGestión P1 - Cuentas Agropecuarias"
    link(rel="stylesheet", href="/css/styles.css")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap", rel="stylesheet")
  body
    header.site-header
      .header-container
        a.brand-link(href="/clientes", aria-label="Inicio AgroGestión P1")
          span.brand-icon 🌾
          span.brand-text AgroGestión P1
        nav.main-nav(aria-label="Navegación principal")
          ul.nav-list
            li
              a.nav-link(href="/clientes") Cuentas Activas
          <!--  li
              a.nav-link.btn-nav(href="/clientes/nuevo") + Nueva Cuenta -->

    main.main-container(role="main")
      block content

    footer.site-footer
      .footer-container
        p &copy; 2026 AgroGestión P1 - DWBE Tecnicatura Superior. Proceso P1: Alta comercial y técnica de cuentas agropecuarias.

