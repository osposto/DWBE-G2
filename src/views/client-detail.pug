extends layout.pug

block content
  nav.breadcrumb-nav(aria-label="Ruta de navegación")
    ol.breadcrumb-list
      li
        a(href="/clientes") Cuentas Agropecuarias
      li.separator /
      li.active(aria-current="page")= cliente.numeroCuenta

  section.page-heading
    h1 Ficha Técnica de Cuenta Agropecuaria
    p.subtitle Expediente comercial y técnico correspondiente al Proceso P1

  article.detail-card
    .detail-header
      .detail-title-group
        h2.client-name= cliente.nombreCliente
        span.badge(class=`badge-${cliente.tipoContrato}`)= `Contrato ${cliente.tipoContrato}`
      span.account-badge Cuenta N° #{cliente.numeroCuenta}

    .detail-body
      dl.data-grid
        .data-item
          dt Razón Social / Productor:
          dd= cliente.nombreCliente

        .data-item
          dt Clave Única de Identificación Tributaria (CUIT):
          dd.cuit-highlight= cliente.cuit

        .data-item
          dt Agrónomo Referente Asignado:
          dd= cliente.agronomoAsignado

        .data-item
          dt Modalidad de Contrato:
          dd(style="text-transform: capitalize;")= cliente.tipoContrato

        .data-item
          dt Fecha de Alta en el Sistema:
          dd= cliente.fechaCreacion

    .detail-footer
      a.btn.btn-secondary(href="/clientes") &larr; Volver al Listado de Cuentas
