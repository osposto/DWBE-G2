extends layout.pug

block content
  nav.breadcrumb-nav(aria-label="Ruta de navegación")
    ol.breadcrumb-list
      li
        a(href="/clientes") Cuentas Agropecuarias
      li.separator /
      li.active(aria-current="page")= cliente.accountNumber

  section.page-heading
    h1 Ficha Técnica de Cuenta Agropecuaria
    p.subtitle Expediente comercial y técnico correspondiente al Proceso P1

  article.detail-card
    .detail-header
      .detail-title-group
        h2.client-name= cliente.clientName
        span.badge(class=`badge-${cliente.contractType}`)= `Contrato ${cliente.contractType}`
      span.account-badge Cuenta N° #{cliente.accountNumber}

    .detail-body
      dl.data-grid
        .data-item
          dt Razón Social / Productor:
          dd= cliente.clientName

        .data-item
          dt Clave Única de Identificación Tributaria (CUIT):
          dd.cuit-highlight= cliente.cuit

        .data-item
          dt Agrónomo Referente Asignado:
          dd= cliente.assignedAgronomist

        .data-item
          dt Modalidad de Contrato:
          dd(style="text-transform: capitalize;")= cliente.contractType

        .data-item
          dt Fecha de Alta en el Sistema:
          dd= cliente.createdAt

    .detail-footer
      a.btn.btn-secondary(href="/clientes") &larr; Volver al Listado de Cuentas
