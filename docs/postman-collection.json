    "name": "DWBE - TP1 Colección Postman",
    "description": "Colección de pruebas de la API REST para el TP1 de Desarrollo Web Backend (DWBE Store). Contiene pruebas para GET, POST, PUT, DELETE, filtros por query y casos de error.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. GET /items - Listar todos los productos (JSON)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Respuesta contiene datos en formato JSON\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('data');",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/items",
          "host": ["{{baseUrl}}"],
          "path": ["items"]
        }
      }
    },
    {
      "name": "2. GET /items?category=Periféricos - Filtro por Categoría",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Todos los productos pertenecen a Periféricos\", function () {",
              "    const jsonData = pm.response.json();",
              "    jsonData.data.forEach(item => {",
              "        pm.expect(item.category.toLowerCase()).to.eql('periféricos');",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/items?category=Periféricos",
          "host": ["{{baseUrl}}"],
          "path": ["items"],
          "query": [
            {
              "key": "category",
              "value": "Periféricos"
            }
          ]
        }
      }
    },
    {
